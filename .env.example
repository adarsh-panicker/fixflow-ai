# FixFlow AI - Environment Configuration Example
# Copy this file to .env.local and fill in your values. Never commit real API keys!

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# Multi-User Authentication & Session Cryptography
# Generate a 32-byte secret with: openssl rand -base64 32
AUTH_SECRET="your_cryptographic_session_secret_32_characters_minimum"
NEXTAUTH_SECRET="your_cryptographic_session_secret_32_characters_minimum"

# Google Gemini API Configuration (Server-Side Only)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Local Monitoring Agent Configuration (Optional - for local prober daemon)
FFA_SERVER_URL="http://localhost:3000"
FFA_AGENT_ID="your_agent_id_here"
FFA_AGENT_KEY="your_agent_key_here"
FFA_WORKSPACE_ID="ws-default"
FFA_POLL_INTERVAL=30
FFA_MAX_CONCURRENCY=5
